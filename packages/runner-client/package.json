{
	"name": "@textmode/runner-client",
	"version": "0.5.0",
	"description": "Browser iframe runtime client for the hosted textmode runner.",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/**/*.d.ts",
		"dist/**/*.js"
	],
	"scripts": {
		"build": "tsc -b",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"lint": "textmode-lint lint .",
		"test": "textmode-build test --passWithNoTests",
		"build:docs": "textmode-docs build",
		"dev:docs": "textmode-docs watch",
		"prepare": "npm run build"
	},
	"dependencies": {
		"@textmode/runner-protocol": "^0.5.0"
	}
}
